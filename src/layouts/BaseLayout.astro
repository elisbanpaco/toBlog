---
import '../styles/global.css';
import { BookOpen, Bookmark, UserRound } from '@lucide/astro';

interface Props {
  title:       string;
  description?: string;
  image?:       string;
  type?:        'website' | 'article';
}

const {
  title,
  description = 'Un blog moderno construido con Astro, Turso y React.',
  image       = '/og-default.png',
  type        = 'website',
} = Astro.props;

import { lucia } from '../lib/lucia';
const sessionId = Astro.cookies.get(lucia.sessionCookieName)?.value;
let user = null;
if (sessionId) {
  const { user: sessionUser } = await lucia.validateSession(sessionId);
  user = sessionUser;
}

const pathname = Astro.url.pathname;
const inArticles = pathname === '/blog' || pathname.startsWith('/blog/');
const inLibrary = pathname === '/biblioteca';
const inAccount = ['/login', '/register', '/forgot-password', '/reset-password', '/verify-notice'].includes(pathname);

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
const ogImage      = image.startsWith('http') ? image : new URL(image, canonicalURL).toString();
---
<!doctype html>
<html lang="es" style="color-scheme: light;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primario -->
    <title>{title} | toBlog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | toBlog`} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | toBlog`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />

  </head>
  <body class="site-body min-h-screen flex flex-col">
    <!-- ─── Header / Navegación estilo Medium ─────────────────────────────── -->
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__brand">
          <img src="/logo.webp" alt="toBlog" width="120" height="40" class="shrink-0" />
        </a>
        <nav class="site-nav" aria-label="Navegación principal">
          <a href="/blog" class="site-nav__link" aria-current={inArticles ? 'page' : undefined}>
            <BookOpen size={22} aria-hidden="true" />
            <span>Artículos</span>
          </a>
          <a href="/biblioteca" class="site-nav__link" aria-current={inLibrary ? 'page' : undefined}>
            <Bookmark size={22} aria-hidden="true" />
            <span>Biblioteca</span>
          </a>
          <a href={user ? '/studio' : '/login'} class="site-nav__cta" aria-current={inAccount ? 'page' : undefined}>
            <UserRound size={22} aria-hidden="true" />
            <span class="desktop-label">{user ? 'Mi Studio' : 'Escribir'}</span>
            <span class="mobile-label">Cuenta</span>
          </a>
        </nav>
      </div>
    </header>

    <!-- ─── Contenido principal ──────────────────────────────────────────── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ─── Footer ──────────────────────────────────────────────────────── -->
    <footer class="site-footer border-t border-slate-200 bg-gradient-to-b from-white to-slate-50 pt-10 pb-6 mt-10 font-sans text-slate-600">
      <div class="max-w-[728px] mx-auto px-6 flex flex-col gap-12">
        
        <div class="flex flex-col md:flex-row justify-between gap-10">
          <div class="max-w-xs">
            <a href="/" class="flex items-center gap-2 font-extrabold text-lg text-slate-900 tracking-tight">
              <img src="/logo.webp" alt="toBlog" width="144" height="48" />
            </a>
            <p class="mt-4 text-sm leading-relaxed text-slate-500">
              Explorando el desarrollo web, tecnología y diseño. Un espacio para aprender y compartir conocimiento de forma abierta.
            </p>
          </div>
          
          <div class="flex gap-12 sm:gap-16">
            <div class="flex flex-col gap-3">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-1">Explorar</h4>
              <a href="/blog" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">Todos los artículos</a>
              <!-- <a href="#" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">Temas</a> -->
              <!-- <a href="#" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">Sobre mí</a> -->
            </div>
            <div class="flex flex-col gap-3">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-1">Conectar</h4>
              <!-- <a href="#" target="_blank" rel="noopener" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">Twitter / X</a> -->
              <a href="https://github.com/elisbanpaco/toBlog" target="_blank" rel="noopener" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">GitHub</a>
              <!-- <a href="#" target="_blank" rel="noopener" class="text-sm hover:text-slate-900 hover:translate-x-1 transition-all duration-200">LinkedIn</a> -->
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center pt-8 border-t border-slate-200 text-sm text-slate-600 gap-4">
          <span>© {new Date().getFullYear()} toBlog. Todos los derechos reservados.</span>
          <div class="footer-legal flex flex-wrap justify-center gap-x-6">
            <a href="/privacidad" class="hover:text-slate-900 transition-colors duration-200">Privacidad</a>
            <a href="/terminos" class="hover:text-slate-900 transition-colors duration-200">Términos</a>
            <a href={user ? "/studio" : "/login"} class="hover:text-slate-900 transition-colors duration-200">{user ? "Mi Studio" : "Iniciar sesión"}</a>
          </div>
        </div>

      </div>
    </footer>
  </body>
</html>

<style>
  /* ─── Header ─────────────────────────────────────────────────────────── */
  .site-header {
    position:      sticky;
    top:           0;
    z-index:       100;
    background:    rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e6e6e6;
    padding:       0 1.5rem;
  }
  .site-header__inner {
    max-width:       728px;
    margin:          0 auto;
    height:          57px;
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    gap:             1rem;
  }
  .site-header__brand {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    font-weight: 800;
    font-size:   1.15rem;
    color:       var(--color-text);
    letter-spacing: -0.03em;
  }
  .site-nav {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size:  0.9rem;
    font-weight: 500;
    color:      var(--color-text-muted);
    padding:    0.4rem 0.75rem;
    border-radius: 999px;
    transition: color 0.15s, background 0.15s;
  }
  .site-nav__link:hover { color: var(--color-text); background: #f2f2f2; }
  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size:     0.9rem;
    font-weight:   600;
    color:         #ffffff;
    background:    var(--color-brand);
    padding:       0.45rem 1rem;
    border-radius: 999px;
    transition:    background 0.15s;
  }
  .site-nav__cta:hover { background: var(--color-brand-hover); }

  .site-nav svg, .mobile-label { display: none; }
  .site-nav [aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .site-nav__link[aria-current="page"] { color: var(--color-text); background: #f2f2f2; }
  .site-header__brand { min-height: 44px; }
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; }
  .site-footer .footer-legal { row-gap: 0.25rem; }
  .site-body :global(a:focus-visible), .site-body :global(button:focus-visible) {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .site-body {
      --mobile-nav-clearance: calc(80px + env(safe-area-inset-bottom, 0px));
      padding-bottom: var(--mobile-nav-clearance);
    }
    .site-header { position: static; backdrop-filter: none; padding: 0 1.25rem; }
    .site-nav {
      position: fixed;
      inset: auto 0 0;
      z-index: 100;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      padding: 0.5rem 1rem calc(0.5rem + env(safe-area-inset-bottom, 0px));
      background: #fff;
      border-top: 1px solid #d1d5db;
    }
    .site-nav__link, .site-nav__cta {
      flex-direction: column;
      gap: 3px;
      min-height: 48px;
      padding: 4px;
      border-radius: 8px;
      font-size: 0.75rem;
      line-height: 1.25;
      color: #4b5563;
      background: transparent;
    }
    .site-nav svg, .mobile-label { display: block; }
    .desktop-label { display: none; }
    .site-nav [aria-current="page"] { color: var(--color-brand-hover); background: var(--color-brand-soft); }
    .site-nav__cta:hover { color: var(--color-text); background: #f2f2f2; }
    .site-footer { margin-top: 1.5rem; padding-top: 2rem; }
  }
</style>
